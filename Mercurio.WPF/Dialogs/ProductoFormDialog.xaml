<UserControl x:Class="Mercurio.WPF.Dialogs.ProductoFormDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="DialogInput" TargetType="TextBox">
            <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="11,8"/>
            <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D9DCE2"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DialogLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#626673"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="DialogPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/><Setter Property="MinWidth" Value="142"/>
            <Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="#17181C"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DialogCancelButton" TargetType="Button">
            <Setter Property="Height" Value="42"/><Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="14,0"/><Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#454852"/><Setter Property="BorderBrush" Value="#D9DCE2"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Border Width="540" Background="White" CornerRadius="14" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Nuevo producto" FontSize="22" FontWeight="SemiBold" Foreground="#17181C"/>
                <TextBlock Text="Agrega un artículo o servicio al catálogo." Foreground="#747784" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="Nombre *" Style="{StaticResource DialogLabel}"/>
                <TextBox x:Name="NombreBox" Style="{StaticResource DialogInput}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="Código de barras (opcional)" Style="{StaticResource DialogLabel}"/>
                <TextBox x:Name="CodigoBox" Style="{StaticResource DialogInput}"/>
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Precio de compra (Bs.)" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="PrecioCompraBox" Text="0" Style="{StaticResource DialogInput}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Precio de venta (Bs.) *" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="PrecioVentaBox" Text="0" Style="{StaticResource DialogInput}"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="ExistenciasPanel" Grid.Row="4" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Stock inicial" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="StockInicialBox" Text="0" Style="{StaticResource DialogInput}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Stock mínimo" Style="{StaticResource DialogLabel}"/>
                    <TextBox x:Name="StockMinimoBox" Text="0" Style="{StaticResource DialogInput}"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="5">
                <CheckBox x:Name="ServicioCheckBox" Content="Es un servicio (no controla existencias)"
                          Margin="0,0,0,6" Checked="ServicioCheckBox_Changed" Unchecked="ServicioCheckBox_Changed"/>
                <TextBlock x:Name="ErrorText" Foreground="#B42318" FontSize="12" TextWrapping="Wrap" MinHeight="20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Cancelar" Style="{StaticResource DialogCancelButton}" Margin="0,0,10,0" Click="Cancelar_Click"/>
                    <Button x:Name="GuardarButton" Content="Guardar producto" Style="{StaticResource DialogPrimaryButton}" Click="Guardar_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
