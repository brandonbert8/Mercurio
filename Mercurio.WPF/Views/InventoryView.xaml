<UserControl x:Class="Mercurio.WPF.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mercurio.WPF">
    <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                            <Grid Margin="0,0,18,0">
                                <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Productos" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="Existencias y precios" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Primary}" Height="38" Margin="0,0,10,0"
                                            Command="{Binding AbrirNuevoProductoCommand}" Content="Nuevo producto"/>
                                    <TextBox Grid.Column="2" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" ToolTip="Buscar por nombre o c&#x00F3;digo"/>
                                </Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Productos}" SelectedItem="{Binding ProductoStockSeleccionado}" Height="520" Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="C&#x00D3;DIGO" Binding="{Binding CodigoBarras}" Width="120"/>
                                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Nombre}" Width="*"/>
                                        <DataGridTextColumn Header="COMPRA" Binding="{Binding PrecioCompra, StringFormat=Bs. {0:N2}}" Width="120"/>
                                        <DataGridTextColumn Header="VENTA" Binding="{Binding PrecioVenta, StringFormat=Bs. {0:N2}}" Width="120"/>
                                        <DataGridTextColumn Header="STOCK" Binding="{Binding StockActual}" Width="80"/>
                                        <DataGridTextColumn Header="M&#x00CD;NIMO" Binding="{Binding StockMinimo}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                            <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"
                                    Padding="22,0,0,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Entrada de stock" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Selecciona un producto de la lista y registra lo que recibiste."
                                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18"/>
                                    <TextBlock Text="Producto seleccionado" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ProductoStockSeleccionado.Nombre, TargetNullValue=Selecciona un producto}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StockActualSeleccionado, StringFormat=Stock actual: {0}}"
                                               Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,16"/>
                                    <TextBlock Text="Cantidad recibida" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CantidadEntradaStock, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Costo unitario (Bs.)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CostoEntradaStock, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                                    <Button Style="{StaticResource Primary}" Command="{Binding RegistrarEntradaStockCommand}" Content="Registrar entrada"/>
                                </StackPanel>
                            </Border>
                        </Grid>
</UserControl>
