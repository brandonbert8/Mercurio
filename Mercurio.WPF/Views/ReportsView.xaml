<UserControl x:Class="Mercurio.WPF.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mercurio.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Desde" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                                    <DatePicker SelectedDate="{Binding FechaReporteDesde}" Width="145"/>
                                    <TextBlock Text="Hasta" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="16,0,8,0"/>
                                    <DatePicker SelectedDate="{Binding FechaReporteHasta}" Width="145"/>
                                    <Button Height="38" Padding="14,0" Margin="12,0,0,0" Background="White" BorderBrush="{StaticResource Line}"
                                            Command="{Binding CargarReportesCommand}" Content="Actualizar reporte"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TotalVentasReporte, StringFormat=Ventas: Bs. {0:N2}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                    <StackPanel><TextBlock Text="Ventas por día" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <DataGrid ItemsSource="{Binding VentasReporte}" Height="245"><DataGrid.Columns>
                                            <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy}}" Width="*"/>
                                            <DataGridTextColumn Header="OPERACIONES" Binding="{Binding CantidadVentas}" Width="110"/>
                                            <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=Bs. {0:N2}}" Width="120"/>
                                        </DataGrid.Columns></DataGrid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                                    <StackPanel><TextBlock Text="Productos más vendidos" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <DataGrid ItemsSource="{Binding ProductosMasVendidosReporte}" Height="245"><DataGrid.Columns>
                                            <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductoNombre}" Width="*"/>
                                            <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad}" Width="100"/>
                                            <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=Bs. {0:N2}}" Width="120"/>
                                        </DataGrid.Columns></DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Background="White" CornerRadius="10" Padding="14">
                                <StackPanel><TextBlock Text="Valorización actual del inventario" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <DataGrid ItemsSource="{Binding ValorizacionReporte}" Height="260"><DataGrid.Columns>
                                        <DataGridTextColumn Header="ALMACÉN" Binding="{Binding AlmacenNombre}" Width="160"/>
                                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductoNombre}" Width="*"/>
                                        <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad}" Width="100"/>
                                        <DataGridTextColumn Header="COSTO" Binding="{Binding CostoUnitario, StringFormat=Bs. {0:N2}}" Width="120"/>
                                        <DataGridTextColumn Header="VALOR" Binding="{Binding Valor, StringFormat=Bs. {0:N2}}" Width="120"/>
                                    </DataGrid.Columns></DataGrid>
                                </StackPanel>
                            </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
