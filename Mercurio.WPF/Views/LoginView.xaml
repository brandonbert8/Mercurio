<UserControl x:Class="Mercurio.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mercurio.WPF">
    <Grid
              Visibility="{Binding IsAuthenticated, Converter={x:Static local:InverseBoolVisibilityConverter.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#17181C" Padding="56,48">
                <StackPanel VerticalAlignment="Center" MaxWidth="560">
                    <Border Width="52" Height="52" CornerRadius="12" Background="White" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <TextBlock Text="M" Foreground="#17181C" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Mercurio" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ModoRegistro, Converter={x:Static local:TituloRegistroConverter.Instance}}"
                               Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,40,0,0"/>
                    <TextBlock Text="{Binding ModoRegistro, Converter={x:Static local:SubtituloRegistroConverter.Instance}}"
                               Foreground="#B7BAC3" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <Border Background="#30323A" Height="1" Margin="0,32,0,24"/>
                    <TextBlock Text="Tu operación diaria, más sencilla" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Ventas, inventario, clientes y caja en un solo lugar, adaptado a negocios como el tuyo."
                               Foreground="#B7BAC3" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" Padding="48,36">
                <Grid>
                    <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Visibility="{Binding ModoRegistro, Converter={x:Static local:InverseBoolVisibilityConverter.Instance}}">
                            <TextBlock Text="Iniciar sesión" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="Selecciona tu negocio y escribe tus datos." Foreground="{StaticResource Muted}" Margin="0,6,0,24"/>
                            <TextBlock Text="Negocio" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <ComboBox Height="42" ItemsSource="{Binding Negocios}" SelectedItem="{Binding NegocioSeleccionado}"
                                      DisplayMemberPath="Nombre" Margin="0,0,0,14"/>
                            <TextBlock Text="Usuario" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                            <TextBlock Text="Contraseña" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="LoginPasswordBox" PasswordChanged="LoginPasswordBox_PasswordChanged" Margin="0,0,0,18"/>
                            <Button Style="{StaticResource Primary}" Command="{Binding IniciarSesionCommand}" Content="Entrar"/>
                            <Button Height="36" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource Muted}" Command="{Binding MostrarRegistroCommand}"
                                    Content="Configurar un negocio nuevo"/>
                        </StackPanel>

                        <StackPanel Width="420" Visibility="{Binding ModoRegistro, Converter={x:Static local:BoolVisibilityConverter.Instance}}">
                            <TextBlock Text="Configuración inicial" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PasoOnboarding, StringFormat='Paso {0} de 3'}" Foreground="{StaticResource Muted}" Margin="0,6,0,18"/>

                            <StackPanel Visibility="{Binding PasoOnboarding, Converter={x:Static local:EqualsOneVisibilityConverter.Instance}}">
                                <TextBlock Text="¿Cómo se llama tu negocio?" FontWeight="SemiBold" FontSize="15"/>
                                <TextBox Text="{Binding NombreNegocioNuevo, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding PasoOnboarding, Converter={x:Static local:EqualsTwoVisibilityConverter.Instance}}">
                                <TextBlock Text="¿Cómo te llamas?" FontWeight="SemiBold" FontSize="15"/>
                                <TextBox Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding PasoOnboarding, Converter={x:Static local:EqualsThreeVisibilityConverter.Instance}}">
                                <TextBlock Text="Crea tu acceso" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                <PasswordBox x:Name="SetupPasswordBox" PasswordChanged="SetupPasswordBox_PasswordChanged"/>
                            </StackPanel>

                            <Grid Margin="0,18,0,0">
                                <Button Height="38" Padding="14,0" HorizontalAlignment="Left" Background="Transparent"
                                        BorderThickness="0" Command="{Binding PasoAnteriorCommand}" Content="Atrás"/>
                                <Button Style="{StaticResource Primary}" HorizontalAlignment="Right"
                                        Command="{Binding SiguientePasoAsyncCommand}" Content="Continuar"
                                        Visibility="{Binding PasoOnboarding, Converter={x:Static local:NotThreeVisibilityConverter.Instance}}"/>
                                <Button Style="{StaticResource Primary}" HorizontalAlignment="Right"
                                        Command="{Binding CrearCuentaCommand}" Content="Terminar"
                                        Visibility="{Binding PasoOnboarding, Converter={x:Static local:EqualsThreeVisibilityConverter.Instance}}"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding Estado}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
</UserControl>
