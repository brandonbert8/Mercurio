<UserControl x:Class="Mercurio.WPF.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mercurio.WPF"
             xmlns:sales="clr-namespace:Mercurio.WPF.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FEF3C7" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding CajaEstaAbierta, Converter={x:Static local:InverseBoolVisibilityConverter.Instance}}">
            <Grid>
                <TextBlock Text="La caja est&#x00E1; cerrada. Abre la caja para registrar pagos en efectivo."
                           Foreground="#92400E" FontSize="12" VerticalAlignment="Center" Margin="0,0,150,0"/>
                <Button HorizontalAlignment="Right" Height="32" Padding="12,0" Background="#D97706"
                        Foreground="White" BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                        Command="{Binding NavegarCommand}" CommandParameter="Caja" Content="Abrir caja"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Productos disponibles" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Busca por nombre o c&#x00F3;digo y agr&#x00E9;galo a la venta."
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BusquedaVenta, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Escribe un nombre o c&#x00F3;digo; presiona Enter para buscar" VerticalAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding BuscarVentaCommand}"/>
                        </TextBox.InputBindings>
                        </TextBox>
                    <Button Grid.Column="1" Style="{StaticResource Primary}" Height="36" Margin="8,0,0,0" Padding="10,0"
                            Command="{Binding AgregarProductoSeleccionadoVentaCommand}" IsEnabled="{Binding HayProductoSeleccionadoVenta}"
                            Content="Agregar seleccionado"/>
                    </Grid>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Productos}" SelectedItem="{Binding ProductoSeleccionadoVenta}" MinHeight="180"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="C&#x00D3;DIGO" Binding="{Binding CodigoBarras}" Width="120"/>
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Nombre}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="PRECIO" Binding="{Binding PrecioVenta, StringFormat=Bs. {0:N2}}" Width="120"/>
                        <DataGridTextColumn Header="STOCK" Binding="{Binding StockActual}" Width="80"/>
                        <DataGridTemplateColumn Header="" Width="112">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="92" Height="32" Margin="3" Padding="6,0"
                                            Command="{Binding DataContext.AgregarAlCarritoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}" IsEnabled="{Binding ., Converter={x:Static sales:ProductoVendibleConverter.Instance}}"
                                            Background="#17181C" Foreground="White"
                                            BorderThickness="0" Content="Agregar"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="White" IsHitTestVisible="False">
                    <TextBlock Text="No hay productos para mostrar. Revisa el cat&#x00E1;logo o cambia la b&#x00FA;squeda."
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="16"/>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Productos.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Ventas recientes" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Ventas}" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VENTA" Binding="{Binding NumeroDocumento}" Width="140"/>
                            <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat={}{0:dd/MM HH:mm}}" Width="140"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=Bs. {0:N2}}" Width="120"/>
                            <DataGridTextColumn Header="ESTADO" Binding="{Binding Estado}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Venta actual" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding EstadoCajaVenta}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent"
                                BorderThickness="0" Foreground="{StaticResource Muted}" Padding="8,4"
                                Command="{Binding LimpiarCarritoCommand}" Content="Vaciar"/>
                    </Grid>

                    <Grid Grid.Row="1" MinHeight="115">
                        <DataGrid ItemsSource="{Binding CarritoVenta}" CanUserAddRows="False" RowHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Nombre}" Width="*" MinWidth="80"/>
                                <DataGridTemplateColumn Header="CANT." Width="62">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="4,2"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="PRECIO" Width="76">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBox Text="{Binding PrecioUnitario, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="4,2"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=Bs. {0:N2}}" Width="70"/>
                                <DataGridTemplateColumn Width="32">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Button Width="26" Height="26" Background="Transparent" BorderThickness="0"
                                                Command="{Binding DataContext.QuitarDelCarritoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Content="&#x00D7;"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Background="White" IsHitTestVisible="False">
                            <TextBlock Text="Agrega productos desde la lista para iniciar la venta."
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="12"/>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CarritoVenta.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,12,0,8">
                        <TextBlock Text="Cliente" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox Height="36" ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteVenta}"
                                  DisplayMemberPath="Nombre" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="M&#x00E9;todo de pago" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox Height="36" ItemsSource="{Binding MetodosPago}" SelectedItem="{Binding MetodoPagoVenta}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Descuento (Bs.)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DescuentoVenta, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,6"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Monto recibido (Bs.)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding MontoPagadoVenta, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,6"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <Grid>
                            <TextBlock Text="Total" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalVenta, StringFormat=Bs. {0:N2}}" HorizontalAlignment="Right" FontSize="19" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,3,0,10">
                            <TextBlock Text="Vuelto" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding VueltoVenta, StringFormat=Bs. {0:N2}}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/>
                        </Grid>
                        <Button Style="{StaticResource Primary}" Height="46" Command="{Binding RegistrarVentaRapidaCommand}"
                                IsEnabled="{Binding PuedeCobrar}" Content="Cobrar y registrar"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
