<UserControl x:Class="Mercurio.WPF.Views.NavigationSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="64"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="D&#x00CD;A A D&#x00CD;A" Margin="24,8,0,6" Foreground="#A3A6AF" FontSize="10" FontWeight="Bold"/>
                        <Button x:Name="NavResumen" Style="{StaticResource NavItem}" Command="{Binding NavegarCommand}" CommandParameter="Resumen"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Resumen"/></StackPanel></Button>
                        <Button x:Name="NavVentas" Style="{StaticResource NavItem}" Command="{Binding NavegarCommand}" CommandParameter="Ventas"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Ventas"/></StackPanel></Button>
                        <Button x:Name="NavCaja" Style="{StaticResource NavItem}" Command="{Binding NavegarCommand}" CommandParameter="Caja"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Caja"/></StackPanel></Button>
                        <TextBlock Text="INVENTARIO" Margin="24,18,0,6" Foreground="#A3A6AF" FontSize="10" FontWeight="Bold"/>
                        <Button x:Name="NavCompras" Style="{StaticResource NavItem}" Command="{Binding NavegarCommand}" CommandParameter="Compras"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Compras"/></StackPanel></Button>
                        <Button x:Name="NavInventario" Style="{StaticResource NavItem}" Command="{Binding NavegarCommand}" CommandParameter="Inventario"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Inventario"/></StackPanel></Button>
                        <Button x:Name="NavProveedores" Style="{StaticResource NavItem}" Command="{Binding NavegarCommand}" CommandParameter="Proveedores"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Proveedores"/></StackPanel></Button>
                        <TextBlock Text="CLIENTES" Margin="24,18,0,6" Foreground="#A3A6AF" FontSize="10" FontWeight="Bold"/>
                        <Button x:Name="NavClientes" Style="{StaticResource NavItem}" Command="{Binding NavegarCommand}" CommandParameter="Clientes"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Clientes"/></StackPanel></Button>
                        <Button x:Name="NavCreditos" Style="{StaticResource NavItem}" Command="{Binding NavegarCommand}" CommandParameter="Creditos"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Cr&#x00E9;ditos y cobros"/></StackPanel></Button>
                        <TextBlock Text="GESTIÓN" Margin="24,18,0,8" Foreground="#A3A6AF" FontSize="10" FontWeight="Bold"/>
                        <Button x:Name="NavReportes"       Style="{StaticResource NavItem}" Command="{Binding NavegarCommand}" CommandParameter="Reportes"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Reportes"/></StackPanel></Button>
                        <Button x:Name="NavConfiguracion"  Style="{StaticResource NavItem}" Command="{Binding NavegarCommand}" CommandParameter="Configuracion"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="28"/><TextBlock Text="Configuración"/></StackPanel></Button>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="14,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="{Binding UsuarioActual.NombreCompleto}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Height="32" Background="Transparent"
                                    BorderThickness="0" Foreground="{StaticResource Muted}" Cursor="Hand"
                                    Command="{Binding CerrarSesionCommand}" ToolTip="Cerrar sesión">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
</UserControl>
